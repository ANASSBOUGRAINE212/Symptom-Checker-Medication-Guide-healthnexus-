# Docker Environment Variables
# Copy this file and rename to .env.docker.local with your actual values
# NEVER commit .env.docker.local to Git!

# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=healthnexus_db
MYSQL_TEST_DATABASE=healthnexus_test

# MongoDB (if using local, otherwise use Atlas)
MONGO_INITDB_DATABASE=healthnexus

# Backend Configuration
DATABASE_URL=mysql://root:your_mysql_password@mysql:3306/healthnexus_db
DATABASE_TEST_URL=mysql://root:your_mysql_password@mysql:3306/healthnexus_test
MONGODB_URI=mongodb://mongodb:27017/healthnexus
MONGODB_TEST_URI=mongodb://mongodb:27017/healthnexus_test

# Admin
ADMIN_EMAIL=your_email@example.com

# JWT Secrets (generate new ones!)
JWT_ACCESS_SECRET=generate-a-secure-random-string-here
JWT_REFRESH_SECRET=generate-another-secure-random-string-here
JWT_EXPIRY=86400000

# Security
COOKIE_SECRET=generate-a-secure-cookie-secret-here
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SESSION_EXPIRY=86400000
ENCRYPTION_SECRET=generate-a-secure-encryption-key-here

# Logging
LOG_LEVEL=warn

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Frontend
VITE_API_URL=http://localhost:5174/api
VITE_ADMIN_EMAIL=your_email@example.com
