# Docker Environment Variables
# Copy this file and rename to .env.docker.local with actual values
# MySQL
MYSQL_ROOT_PASSWORD=mysql_password
MYSQL_DATABASE=healthnexus_db
MYSQL_TEST_DATABASE=healthnexus_test

# MongoDB 
MONGO_INITDB_DATABASE=healthnexus

# Backend Configuration
DATABASE_URL=mysql://root:mysql_password@mysql:3306/healthnexus_db
DATABASE_TEST_URL=mysql://root:mysql_password@mysql:3306/healthnexus_test
MONGODB_URI=mongodb://mongodb:27017/healthnexus
MONGODB_TEST_URI=mongodb://mongodb:27017/healthnexus_test

# Admin
ADMIN_EMAIL=email@example.com

# JWT Secrets 
JWT_ACCESS_SECRET=generate-a-secure-random-string
JWT_REFRESH_SECRET=generate-another-secure-random-string
JWT_EXPIRY=86400000

# Security
COOKIE_SECRET=generate-a-secure-cookie-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SESSION_EXPIRY=86400000
ENCRYPTION_SECRET=generate-a-secure-encryption-key

# Logging
LOG_LEVEL=warn

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASS=your_app_password_here

# Frontend
VITE_API_URL=http://localhost:5174/api
VITE_ADMIN_EMAIL=your_email@example.com
