# HealthNexus Environment Variables
# DATABASE CONFIGURATION
# MySQL - for users, authentication, diagnoses
DATABASE_URL="mysql://username:password@localhost:3306/healthnexus_db"

# MongoDB - for diseases and medications
MONGODB_URI="mongodb://localhost:27017/healthnexus"


# ADMIN CONFIGURATION
ADMIN_EMAIL="admin@example.com"
VITE_ADMIN_EMAIL="admin@example.com"


# JWT AUTHENTICATION
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="super-secure-access-token-secret-change-in-production"
JWT_REFRESH_SECRET="super-secure-refresh-token-secret-change-in-production"
JWT_EXPIRY=86400000


# SECURITY CONFIGURATION
# Generated with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET="cookie-secret-here"
ENCRYPTION_SECRET="encryption-key-here-32-bytes-minimum"

# CORS CONFIGURATION
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"


# APP CONFIGURATION
NODE_ENV=development
PORT=5174
LOG_LEVEL=info
SESSION_EXPIRY=86400000

# REDIS CONFIGURATION 
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379


# EMAIL CONFIGURATION (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASS=app-password


# BACKUP CONFIGURATION
BACKUP_INTERVAL_HOURS=24
