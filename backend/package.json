{
  "name": "healthnexus-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate --schema=./database/prisma/schema.prisma",
    "prisma:studio": "node ./node_modules/prisma/build/index.js studio --schema=./database/prisma/schema.prisma",
    "prisma:push": "node ./node_modules/prisma/build/index.js db push --schema=./database/prisma/schema.prisma",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev --schema=./database/prisma/schema.prisma",
    "db:push": "node ./node_modules/prisma/build/index.js db push --schema=./database/prisma/schema.prisma",
    "db:studio": "node ./node_modules/prisma/build/index.js studio --schema=./database/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.0",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "redis": "^5.10.0",
    "uuid": "^13.0.0",
    "xss": "^1.0.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^7.0.3",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.14.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
