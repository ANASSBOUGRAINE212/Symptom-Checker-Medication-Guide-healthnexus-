generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   // bcrypt hash
  firstName    String?
  lastName     String?
  
  // Email verification
  emailVerified      Boolean   @default(false)
  verificationCode   String?
  verificationExpiry DateTime?
  
  // Password reset
  resetCode          String?
  resetExpiry        DateTime?
  
  // Account status
  isActive Boolean @default(true)
  role     Role    @default(USER)
  
  // Security fields
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  profile                  UserProfile?
  diagnoses                Diagnosis[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  // Security tracking
  ipAddress  String?
  userAgent  String?  @db.Text
  isRevoked  Boolean  @default(false)
  
  // Session management
  rememberMe Boolean  @default(false)
  deviceName String?  @db.VarChar(255)
  lastUsedAt DateTime @default(now())
  
  @@index([userId])
  @@index([token(length: 255)])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(255)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(255)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

enum Role {
  USER
  ADMIN
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal info
  dateOfBirth DateTime?
  gender      String?
  country     String?
  
  // Medical info
  height      Int?     // in cm
  weight      Int?     // in kg
  bloodType   String?
  allergies   String?  @db.Text
  
  // Settings
  darkMode            Boolean @default(false)
  dataSharing         Boolean @default(true)
  
  // Security preferences
  securityPreferences Json?   // { sessionTimeout, autoLogout, requireReauth }
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model Disease {
  id                 String   @id @default(cuid())
  name               String   @unique
  category           String
  categories         Json?
  severity           String
  definition         String   @db.Text
  symptoms           Json     // Array of strings
  causes             Json     // Array of strings
  testsAndProcedures Json     // Array of strings
  medications        Json     // Array of strings
  treatments         Json     // Array of strings
  prevention         Json     // Array of strings
  prognosis          String   @db.Text
  prevalence         String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  diagnoses Diagnosis[]

  @@map("diseases")
}

model Medication {
  id                 String   @id @default(cuid())
  name               String   @unique
  purpose            String   @db.Text
  disease            Json     // Array of disease IDs or names
  category           String
  categories         Json?
  sideEffects        String   @db.Text
  dosage             Json     // Array of strings
  contraindications  Json     // Array of strings
  interactions       Json     // Array of strings
  howItWorks         String   @db.Text
  whenToTake         String   @db.Text
  warnings           Json     // Array of strings
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("medications")
}

model Diagnosis {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Encrypted fields for enhanced security
  symptomsEncrypted String   @db.Text // Encrypted symptoms data (now required)
  resultsEncrypted  String   @db.Text // Encrypted results data (now required)
  
  createdAt DateTime @default(now())

  // Relations
  diseaseId String?
  disease   Disease? @relation(fields: [diseaseId], references: [id])

  @@map("diagnoses")
}

// Admin functionality is now handled by User.role = ADMIN
// No separate Admin table needed
