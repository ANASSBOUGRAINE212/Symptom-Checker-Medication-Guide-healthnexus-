# HealthNexus Environment Variables


# DATABASE CONFIGURATION
DATABASE_URL="mysql://username:password@localhost:3306/healthnexus_db"


# ADMIN CONFIGURATION
ADMIN_EMAIL="admin@example.com"
VITE_ADMIN_EMAIL="admin@example.com"


# JWT AUTHENTICATION
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="your-super-secure-access-token-secret-change-in-production"
JWT_REFRESH_SECRET="your-super-secure-refresh-token-secret-change-in-production"
JWT_EXPIRY=86400000


# SECURITY CONFIGURATION
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET="your-cookie-secret-here"
ENCRYPTION_SECRET="your-encryption-key-here-32-bytes-minimum"

# CORS CONFIGURATION
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"


# APP CONFIGURATION
NODE_ENV=development
PORT=5174
LOG_LEVEL=info
SESSION_EXPIRY=86400000

# REDIS CONFIGURATION (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379


# EMAIL CONFIGURATION (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here


# BACKUP CONFIGURATION
BACKUP_INTERVAL_HOURS=24


# DEMO MODE (for static deployment)
VITE_DEMO_MODE=false
